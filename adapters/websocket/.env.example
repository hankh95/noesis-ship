# Noesis Ship — WebSocket Adapter Configuration
# Copy to .env and fill in your values

# WebSocket port for client connections
WS_PORT=3100

# Agent roster — format: id:Name,id:Name
AGENTS=mini:Mini,m5:M5,dgx:DGX,copilot:Copilot

# Claude Code session watcher (optional)
# Path to Claude project sessions dir (e.g. ~/.claude/projects/-Users-you-Projects-myproject)
CLAUDE_SESSION_DIR=

# Display name for this machine's agent
MACHINE_NAME=

# Default group ID for session messages
SESSION_GROUP_ID=

# HTTP port for agent API (default: WS_PORT + 2)
# AGENT_API_PORT=3102
