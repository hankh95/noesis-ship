{
  "name": "noesis-ship",
  "version": "0.1.0",
  "description": "Pluggable multi-agent communication platform — NATS core with WebSocket, MCP, and HTTP/SSE adapters",
  "private": true,
  "workspaces": [
    "adapters/websocket"
  ],
  "scripts": {
    "start": "cd adapters/websocket && node -r dotenv/config server.js",
