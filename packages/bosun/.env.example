# Bosun Service Configuration
# ============================
#
# IMPORTANT: Use Doppler for secrets in production!
#
#   doppler run -- npm run bosun
#
# Doppler project: nusy-fleet (or your configured project)
# Required secrets in Doppler: ANTHROPIC_API_KEY
#
# This .env.example is for local development only.

# NATS connection
NATS_URL=nats://localhost:4222

# Anthropic API key (use Doppler in production!)
# Get from: doppler secrets get ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...

# NuSy project directory (lowercase 'projects' on DGX)
NUSY_PROJECT_DIR=/home/hankh959/projects/nusy-product-team

# Fleet spawn script path
FLEET_SPAWN_PATH=/home/hankh959/projects/nusy-product-team/scripts/fleet-spawn.sh

# Scan interval in minutes (default: 30)
SCAN_INTERVAL_MINUTES=30

# Run scan immediately on startup
SCAN_ON_STARTUP=true

# Machine name for NATS origin tagging
MACHINE_NAME=DGX

# Claude model for reasoning (sonnet for speed, opus for quality)
REASONING_MODEL=claude-sonnet-4-6
