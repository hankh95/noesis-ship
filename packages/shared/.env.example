# Noesis Ship — Configuration
# Copy to .env in any package directory and fill in your values.
# All packages share these variables via @noesis-ship/shared.

# ─── NATS ────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ─── Relay (packages/relay) ──────────────────────────────────────────────────
WS_PORT=3100
AGENTS=mini:Mini,m5:M5,dgx:DGX,copilot:Copilot
MACHINE_NAME=
SESSION_GROUP_ID=
# AGENT_API_PORT=3102

# ─── Daemon (packages/daemon) ───────────────────────────────────────────────
# WebSocket fallback URL (used when NATS unavailable)
BRIDGE_URL=ws://localhost:3100
AGENT_NAME=
PROJECT_DIR=
MAX_TURNS=10
PERMISSION_MODE=bypassPermissions

# ─── Relay — Session Watcher (optional) ─────────────────────────────────────
# Path to Claude project sessions dir
# e.g. ~/.claude/projects/-Users-you-Projects-myproject
CLAUDE_SESSION_DIR=

# ─── Fleet Log (packages/fleet-log) ─────────────────────────────────────────
# LOG_DIR=   # Override log output directory (default: auto-detected ~/projects or ~/Projects)
# WINDOW_HOURS=4  # Transcript window size in hours
