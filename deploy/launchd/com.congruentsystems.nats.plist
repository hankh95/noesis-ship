<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Noesis Ship — NATS Server (macOS launchd)

  Install:
    cp config/launchd/com.congruentsystems.nats.plist ~/Library/LaunchAgents/
    # Edit paths: replace __HOME__ with your actual home directory
    launchctl load ~/Library/LaunchAgents/com.congruentsystems.nats.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.congruentsystems.nats.plist
    rm ~/Library/LaunchAgents/com.congruentsystems.nats.plist
-->
<dict>
    <key>Label</key>
    <string>com.congruentsystems.nats</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/nats-server</string>
        <string>-c</string>
        <string>__HOME__/projects/noesis-ship/config/nats-server.conf</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/projects/noesis-ship</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/nats-server.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/nats-server-error.log</string>
</dict>
</plist>
